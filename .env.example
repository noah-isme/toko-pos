# Kios POS - example environment variables
# Copy this file to .env and fill in real credentials before running in "database mode".

# ---------- Database (Supabase/Postgres) ------------------------------------
# For hosted Supabase: get the connection string from Project -> Settings -> Database -> Connection string
# Example (change user/password/host/db as appropriate):
DATABASE_URL="postgresql://postgres:postgres@db-host:5432/kios_pos?schema=public"

# Prisma's shadow database (used by migrations). For Supabase projects you can create
# a separate smaller DB or use a different schema. Optional for prisma db:push but
# recommended for migrate workflows.
SHADOW_DATABASE_URL="postgresql://postgres:postgres@db-host:5432/kios_pos_shadow?schema=public"

# ---------- NextAuth / App Settings -----------------------------------------
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="dev-secret-change-me"

# Google OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# SMTP (used for magic link email sign-in). If you don't need email auth locally,
# you can leave these blank and rely on mock auth/MSW while developing.
EMAIL_SERVER_HOST="smtp.example.com"
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER="apikey"
EMAIL_SERVER_PASSWORD="supersecret"
EMAIL_FROM="Kios POS <no-reply@example.com>"

# ---------- Supabase client (optional - enables real Supabase features)
# Public client values (exposed to browser if prefixed with NEXT_PUBLIC_)
SUPABASE_URL="https://your-project.supabase.co"

# NEW API keys (Supabase 2025+): Project -> Settings -> API Keys.
# Publishable key replaces the legacy anon key ("sb_publishable_...").
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
# Secret key replaces the legacy service_role key ("sb_secret_..."). Server-only.
SUPABASE_SECRET_KEY="sb_secret_xxx"

# LEGACY anon key (deprecated) - leave empty when using the publishable key.
SUPABASE_ANON_KEY=""

NEXT_PUBLIC_SUPABASE_URL="$SUPABASE_URL"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="$SUPABASE_PUBLISHABLE_KEY"
NEXT_PUBLIC_SUPABASE_ANON_KEY="$SUPABASE_ANON_KEY"

# If SUPABASE_URL and no Supabase key (publishable or anon) are set, the app will
# automatically run in mock mode (MSW + IndexedDB) for local UI/E2E development.

# ---------- App specific / optional -----------------------------------------
DISCOUNT_LIMIT_PERCENT=50
STORE_NPWP=""

# ---------- Payment Gateways (optional) -------------------------------------
# Default mode is "mock" which simulates QRIS/EDC flows locally. Set provider
# to "xendit" or "midtrans" for real QRIS, and configure EDC_PROVIDER for
# card terminals. All keys are server-only and never sent to the browser.
PAYMENT_GATEWAY_PROVIDER="mock"
PAYMENT_GATEWAY_MODE="sandbox"

# Xendit (QRIS) - server-only secret key
XENDIT_SECRET_KEY=""
XENDIT_PUBLIC_KEY=""
# XENDIT_API_URL="https://api.xendit.co" # live; sandbox uses https://api.xendit.co

# Midtrans (QRIS) - server-only server key
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
# MIDTRANS_API_URL="https://app.midtrans.com" # live; sandbox uses https://app.sandbox.midtrans.com

# EDC / Card terminal (optional)
EDC_PROVIDER="mock"
EDC_API_URL=""
EDC_TERMINAL_ID=""
EDC_MERCHANT_ID=""

# Webhook secret used to validate callback signatures from payment gateways
PAYMENT_WEBHOOK_SECRET=""

# ---------- WhatsApp Notifications (optional) ---------------------------------
# Default mode is "mock" which logs messages locally. Set provider to "wablas",
# "fonnte", or "custom" for real WhatsApp API integration.
WHATSAPP_PROVIDER="mock"
WHATSAPP_API_URL=""
WHATSAPP_API_KEY=""
WHATSAPP_DEVICE_ID=""
WHATSAPP_SENDER_ID=""

# ---------- Notes ------------------------------------------------------------
# 1) After filling this file, create a copy named `.env` in the project root:
#    cp .env.example .env
# 2) Install deps: pnpm install
# 3) Generate Prisma client (postinstall already runs this): pnpm run db:generate
# 4) Apply schema to the database: pnpm run db:push
# 5) (Optional) Seed initial products to Supabase/Postgres: pnpm run seed:products
# 6) Run dev server: pnpm run dev
